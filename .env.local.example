# Copy to .env.local for local development:  cp .env.local.example .env.local
# For Vercel: add the same variables under Project → Settings → Environment
# Variables (Production + Preview). None of these are NEXT_PUBLIC_ — the app
# only reads them on the server, which is what keeps the service-role key safe.

# Supabase — project Settings → API
#   Project URL:            SUPABASE_URL
#   service_role (secret):  SUPABASE_SERVICE_ROLE_KEY
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Session-cookie signing key for admin/coordinator logins (any long random
# string, e.g. `openssl rand -base64 32`). Must be stable or all sessions
# log out.
ZEON_SESSION_SECRET=change-me-to-a-long-random-string
